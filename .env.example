# Flask Application Settings
APP_ENV=development
APP_SECRET_KEY=generate-a-secure-random-secret-key-for-session-and-tokens
PORT=5000
DEBUG=False
TZ=Asia/Kolkata

# Supabase PostgreSQL Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use service_role / secret key for backend server operations (bypasses RLS)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
# Legacy alias if applicable
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Google Sheets API Integration
# The unique ID from the Google Sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here
# Base64 encoded Google Service Account JSON credentials
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json-string
# Or alternative direct path for local debugging:
# GOOGLE_SERVICE_ACCOUNT_FILE_PATH=./service_account.json

# Administrator Credentials
ADMIN_USERNAME=admin
# Generate using: python scripts/generate_admin_hash.py
ADMIN_PASSWORD_HASH=generate_with_scripts_generate_admin_hash_py

# Demo Meeting Configuration
# Clearly identified placeholder Zoom/Meeting link
DEMO_MEETING_URL=https://zoom.us/j/placeholder-kmie-demo-session

# Rate Limiting & Storage (Optional, defaults to in-memory)
RATELIMIT_STORAGE_URI=memory://
